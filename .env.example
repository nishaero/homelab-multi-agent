# Optional overrides: HLAGENTS_CONFIG (path to config.yaml), HLAGENTS_MODEL (model name), OLLAMA_URL.
# Read only access is enough for the tools. Phone approval buttons also need to call a notify service
# and listen for events, which needs a token with more rights. Dry run is the default.
# Read only access is enough: the agents only read, changes need a human to approve.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# MEMORY_TOKEN=
# INTAKE_TOKEN=

# Remote access
# API_TOKEN=             # openssl rand -hex 24
# MCP_SECRET=            # openssl rand -hex 16
# HLAGENTS_API=http://127.0.0.1:8111
